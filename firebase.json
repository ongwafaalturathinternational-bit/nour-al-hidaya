{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/.git/**",
      "docs/**",
      "SECURITE-ET-ROADMAP.md",
      "firestore.rules",
      ".firebaserc",
      "tests/**",
      ".github/**",
      "**/*.test.*",
      "*.md"
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}
