{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/.git/**",
      "docs/**",
      "SECURITE-ET-ROADMAP.md",
      "firestore.rules",
      ".firebaserc",
      "tests/**",
      ".github/**",
      "**/*.test.*",
      "*.md",
      "functions/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "npm-shrinkwrap.json",
      "*.zip",
      "*.apk",
      "*.aab",
      "*.keystore",
      "*.jks",
      ".env*"
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}
