rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Registre central des accès d'équipe. Les rôles sont attribués hors client
    // par un administrateur de confiance; aucun utilisateur ne peut les écrire.
    function staffAccessExists(userId) {
      return exists(/databases/$(database)/documents/staffAccess/$(userId));
    }

    function staffAccessData(userId) {
      return get(/databases/$(database)/documents/staffAccess/$(userId)).data;
    }

    // Les dates métier sont stockées au format ISO 8601 réduit (YYYY-MM-DD).
    // La comparaison lexicographique n'est fiable que pour ce format.
    function validIsoDate(value) {
      // Vérifie le calendrier grégorien, y compris les années bissextiles.
      return value is string
        && value.size() == 10
        && (
          value.matches('^[0-9]{4}-(01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])$')
          || value.matches('^[0-9]{4}-(04|06|09|11)-(0[1-9]|[12][0-9]|30)$')
          || value.matches('^[0-9]{4}-02-(0[1-9]|1[0-9]|2[0-8])$')
          || value.matches('^[0-9]{2}(0[48]|[2468][048]|[13579][26])-02-29$')
          || value.matches('^([02468][048]|[13579][26])00-02-29$')
        );
    }
    function validOptionalDateRange(data) {
      return (!("startDate" in data) || validIsoDate(data.startDate))
        && (!("endDate" in data) || validIsoDate(data.endDate))
        && (!("startDate" in data) || !("endDate" in data) || data.startDate <= data.endDate);
    }

    // Les tableaux saisis dans le formulaire restent des listes de textes bornées
    // même si un client modifié contourne les limites HTML.
    function validApplicationTextListItem(values, index) {
      return values.size() <= index
        || (values[index] is string
          && values[index].size() >= 1
          && values[index].size() <= 120);
    }

    function validApplicationTextList(values) {
      return values is list
        && values.size() <= 20
        && validApplicationTextListItem(values, 0)
        && validApplicationTextListItem(values, 1)
        && validApplicationTextListItem(values, 2)
        && validApplicationTextListItem(values, 3)
        && validApplicationTextListItem(values, 4)
        && validApplicationTextListItem(values, 5)
        && validApplicationTextListItem(values, 6)
        && validApplicationTextListItem(values, 7)
        && validApplicationTextListItem(values, 8)
        && validApplicationTextListItem(values, 9)
        && validApplicationTextListItem(values, 10)
        && validApplicationTextListItem(values, 11)
        && validApplicationTextListItem(values, 12)
        && validApplicationTextListItem(values, 13)
        && validApplicationTextListItem(values, 14)
        && validApplicationTextListItem(values, 15)
        && validApplicationTextListItem(values, 16)
        && validApplicationTextListItem(values, 17)
        && validApplicationTextListItem(values, 18)
        && validApplicationTextListItem(values, 19)
        && values.join(",").size() <= 500;
    }

    function activeStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && staffAccessExists(request.auth.uid)
        && staffAccessData(request.auth.uid).active == true;
    }

    function staffHasRole(role) {
      return activeStaff() && staffAccessData(request.auth.uid).role == role;
    }

    // Un membre de l'équipe peut consulter uniquement son propre registre d'accès.
    // La création, la modification et la suppression sont réservées à l'administration
    // de confiance via la console ou un futur processus serveur sécurisé.
    match /staffAccess/{userId} {
      allow get: if signedInAs(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }


    // Accès par périmètre : un rôle seul ne suffit jamais à ouvrir une collection.
    function staffHasScope(scope) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && staffAccessExists(request.auth.uid)
        && staffAccessData(request.auth.uid).active == true
        && staffAccessData(request.auth.uid).scopes is list
        && staffAccessData(request.auth.uid).scopes.hasAny([scope]);
    }

    // Annuaire institutionnel : informations de contact minimales, sans notes sensibles.

    // Référentiel des programmes institutionnels WAT.
    match /programs/{programId} {
      allow read: if staffHasScope("programs.read") || staffHasScope("programs.manage");

      allow create: if staffHasScope("programs.manage")
        && request.resource.data.keys().hasOnly([
          "name", "code", "description", "category", "status",
          "startDate", "endDate", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.keys().hasAll([
          "name", "code", "description", "category", "status",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 2
        && request.resource.data.code.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 1
        && request.resource.data.description.size() <= 1500
        && request.resource.data.category in ["education", "social", "humanitaire", "formation", "autre"]
        && request.resource.data.status in ["planifie", "actif", "suspendu", "termine"]
        && validOptionalDateRange(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if staffHasScope("programs.manage")
        && request.resource.data.keys().hasOnly([
          "name", "code", "description", "category", "status",
          "startDate", "endDate", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.keys().hasAll([
          "name", "code", "description", "category", "status",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 2
        && request.resource.data.code.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 1
        && request.resource.data.description.size() <= 1500
        && request.resource.data.category in ["education", "social", "humanitaire", "formation", "autre"]
        && request.resource.data.status in ["planifie", "actif", "suspendu", "termine"]
        && validOptionalDateRange(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    // Activités de terrain : planification et suivi institutionnel.
    match /activities/{activityId} {
      allow read: if staffHasScope("activities.read") || staffHasScope("activities.manage");
      allow create: if staffHasScope("activities.manage")
        && request.resource.data.keys().hasOnly(["title", "description", "category", "activityDate", "location", "projectId", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.keys().hasAll(["title", "description", "category", "activityDate", "location", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 140
        && request.resource.data.description is string && request.resource.data.description.size() <= 2000
        && request.resource.data.category in ["formation", "humanitaire", "social", "reunion", "sensibilisation", "autre"]
        && validIsoDate(request.resource.data.activityDate)
        && request.resource.data.location is string && request.resource.data.location.size() <= 180
        && request.resource.data.status in ["planifiee", "realisee", "annulee"]
        && (!("projectId" in request.resource.data) || (request.resource.data.projectId is string && request.resource.data.projectId.size() >= 1 && request.resource.data.projectId.size() <= 100 && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))))
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if staffHasScope("activities.manage")
        && request.resource.data.keys().hasOnly(["title", "description", "category", "activityDate", "location", "projectId", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.keys().hasAll(["title", "description", "category", "activityDate", "location", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 140
        && request.resource.data.description is string && request.resource.data.description.size() <= 2000
        && request.resource.data.category in ["formation", "humanitaire", "social", "reunion", "sensibilisation", "autre"]
        && validIsoDate(request.resource.data.activityDate)
        && request.resource.data.location is string && request.resource.data.location.size() <= 180
        && request.resource.data.status in ["planifiee", "realisee", "annulee"]
        && (!("projectId" in request.resource.data) || (request.resource.data.projectId is string && request.resource.data.projectId.size() >= 1 && request.resource.data.projectId.size() <= 100 && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))))
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;

    }

    // Feuilles de présence centralisées pour faciliter les rapports multi-activités.
    match /attendance/{recordId} {
      allow read: if staffHasScope("attendance.read") || staffHasScope("attendance.manage");
      allow create: if staffHasScope("attendance.manage")
        && request.resource.data.keys().hasOnly(["activityId", "participantRef", "participantLabel", "participantType", "status", "recordedAt", "recordedBy", "updatedAt", "updatedBy"])
        && request.resource.data.keys().hasAll(["activityId", "participantRef", "participantLabel", "participantType", "status", "recordedAt", "recordedBy", "updatedAt", "updatedBy"])
        && request.resource.data.activityId is string && request.resource.data.activityId.size() >= 1 && request.resource.data.activityId.size() <= 100
        && exists(/databases/$(database)/documents/activities/$(request.resource.data.activityId))
        && request.resource.data.participantRef is string && request.resource.data.participantRef.size() >= 1 && request.resource.data.participantRef.size() <= 100
        && request.resource.data.participantLabel is string && request.resource.data.participantLabel.size() >= 2 && request.resource.data.participantLabel.size() <= 120
        && request.resource.data.participantType in ["membre", "benevole", "apprenant", "beneficiaire", "invite"]
        && request.resource.data.status in ["present", "absent", "excuse"]
        && request.resource.data.recordedAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.recordedBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if staffHasScope("attendance.manage")
        && request.resource.data.keys().hasOnly(["activityId", "participantRef", "participantLabel", "participantType", "status", "recordedAt", "recordedBy", "updatedAt", "updatedBy"])
        && request.resource.data.keys().hasAll(["activityId", "participantRef", "participantLabel", "participantType", "status", "recordedAt", "recordedBy", "updatedAt", "updatedBy"])
        && request.resource.data.activityId == resource.data.activityId
        && request.resource.data.participantRef == resource.data.participantRef
        && request.resource.data.participantType == resource.data.participantType
        && request.resource.data.participantLabel is string && request.resource.data.participantLabel.size() >= 2 && request.resource.data.participantLabel.size() <= 120
        && request.resource.data.status in ["present", "absent", "excuse"]
        && request.resource.data.recordedAt == resource.data.recordedAt && request.resource.data.recordedBy == resource.data.recordedBy
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }


    match /members/{memberId} {
      allow read: if staffHasScope("members.read") || staffHasScope("members.manage");

      allow create: if staffHasScope("members.manage")
        && request.resource.data.keys().hasOnly([
          "fullName", "email", "phone", "memberType", "status", "position",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.keys().hasAll([
          "fullName", "memberType", "status", "createdAt", "createdBy",
          "updatedAt", "updatedBy"
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.memberType in ["fondateur", "membre", "benevole"]
        && request.resource.data.status in ["actif", "inactif", "suspendu"]
        && (!("email" in request.resource.data) || (
          request.resource.data.email is string
          && request.resource.data.email.size() <= 160
        ))
        && (!("phone" in request.resource.data) || (
          request.resource.data.phone is string
          && request.resource.data.phone.size() <= 30
        ))
        && (!("position" in request.resource.data) || (
          request.resource.data.position is string
          && request.resource.data.position.size() <= 100
        ))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if staffHasScope("members.manage")
        && request.resource.data.keys().hasOnly([
          "fullName", "email", "phone", "memberType", "status", "position",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.keys().hasAll([
          "fullName", "memberType", "status", "createdAt", "createdBy",
          "updatedAt", "updatedBy"
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.memberType in ["fondateur", "membre", "benevole"]
        && request.resource.data.status in ["actif", "inactif", "suspendu"]
        && (!("email" in request.resource.data) || (
          request.resource.data.email is string
          && request.resource.data.email.size() <= 160
        ))
        && (!("phone" in request.resource.data) || (
          request.resource.data.phone is string
          && request.resource.data.phone.size() <= 30
        ))
        && (!("position" in request.resource.data) || (
          request.resource.data.position is string
          && request.resource.data.position.size() <= 100
        ))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      // Conservation de l'historique : désactiver une fiche au lieu de la supprimer.
      allow delete: if false;
    }

    // Projets : actions délimitées dans le temps, rattachables à un programme.
    match /projects/{projectId} {
      allow read: if staffHasScope("projects.read") || staffHasScope("projects.manage");
      allow create: if staffHasScope("projects.manage")
        && request.resource.data.keys().hasOnly(["name", "code", "description", "programId", "status", "startDate", "endDate", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.keys().hasAll(["name", "code", "description", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 140
        && request.resource.data.code is string && request.resource.data.code.size() >= 2 && request.resource.data.code.size() <= 40
        && request.resource.data.description is string && request.resource.data.description.size() <= 2000
        && request.resource.data.status in ["planifie", "en_cours", "suspendu", "termine"]
        && (!("programId" in request.resource.data) || (request.resource.data.programId is string && request.resource.data.programId.size() >= 1 && request.resource.data.programId.size() <= 100 && exists(/databases/$(database)/documents/programs/$(request.resource.data.programId))))
        && validOptionalDateRange(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if staffHasScope("projects.manage")
        && request.resource.data.keys().hasOnly(["name", "code", "description", "programId", "status", "startDate", "endDate", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.keys().hasAll(["name", "code", "description", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 140
        && request.resource.data.code is string && request.resource.data.code.size() >= 2 && request.resource.data.code.size() <= 40
        && request.resource.data.description is string && request.resource.data.description.size() <= 2000
        && request.resource.data.status in ["planifie", "en_cours", "suspendu", "termine"]
        && (!("programId" in request.resource.data) || (request.resource.data.programId is string && request.resource.data.programId.size() >= 1 && request.resource.data.programId.size() <= 100 && exists(/databases/$(database)/documents/programs/$(request.resource.data.programId))))
        && validOptionalDateRange(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;

      match /volunteers/{assignmentId} {
        // Les affectations exposent des noms de bénévoles : un droit projet seul ne suffit pas.
        allow read: if (staffHasScope("projects.read") || staffHasScope("projects.manage"))
          && (staffHasScope("volunteers.read") || staffHasScope("volunteers.manage"));
        allow create: if staffHasScope("projects.manage")
          && (staffHasScope("volunteers.read") || staffHasScope("volunteers.manage"))
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && request.resource.data.keys().hasOnly(["volunteerId", "volunteerName", "assignmentRole", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
          && request.resource.data.keys().hasAll(["volunteerId", "volunteerName", "assignmentRole", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
          && request.resource.data.volunteerId is string
          && request.resource.data.volunteerId == assignmentId
          && request.resource.data.volunteerId.size() >= 1 && request.resource.data.volunteerId.size() <= 100
          && exists(/databases/$(database)/documents/volunteers/$(request.resource.data.volunteerId))
          && get(/databases/$(database)/documents/volunteers/$(request.resource.data.volunteerId)).data.status == "actif"
          && request.resource.data.volunteerName == get(/databases/$(database)/documents/volunteers/$(request.resource.data.volunteerId)).data.fullName
          && request.resource.data.volunteerName is string && request.resource.data.volunteerName.size() >= 2 && request.resource.data.volunteerName.size() <= 120
          && request.resource.data.assignmentRole is string && request.resource.data.assignmentRole.size() <= 100
          && request.resource.data.status in ["propose", "confirme", "retire"]
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
        allow update: if staffHasScope("projects.manage")
          && (staffHasScope("volunteers.read") || staffHasScope("volunteers.manage"))
          && request.resource.data.keys().hasOnly(["volunteerId", "volunteerName", "assignmentRole", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
          && request.resource.data.keys().hasAll(["volunteerId", "volunteerName", "assignmentRole", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
          && request.resource.data.volunteerId == resource.data.volunteerId
          && request.resource.data.volunteerId == assignmentId
          && request.resource.data.volunteerName == resource.data.volunteerName
          && request.resource.data.volunteerName is string && request.resource.data.volunteerName.size() >= 2 && request.resource.data.volunteerName.size() <= 120
          && request.resource.data.assignmentRole is string && request.resource.data.assignmentRole.size() <= 100
          && request.resource.data.status in ["propose", "confirme", "retire"]
          && (
            request.resource.data.status == "retire"
            || (
              existsAfter(/databases/$(database)/documents/volunteers/$(assignmentId))
              && getAfter(/databases/$(database)/documents/volunteers/$(assignmentId)).data.status == "actif"
            )
          )
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
    }

    // Club Khuddam Al-Turath : registre privé des bénévoles, sans accès public.
    match /volunteers/{volunteerId} {
      allow read: if staffHasScope("volunteers.read") || staffHasScope("volunteers.manage");
      allow create: if staffHasScope("volunteers.manage")
        && request.resource.data.keys().hasOnly(["fullName", "email", "phone", "category", "skills", "interests", "availability", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.keys().hasAll(["fullName", "category", "skills", "interests", "availability", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() >= 2 && request.resource.data.fullName.size() <= 120
        && request.resource.data.category in ["occasionnel", "engage", "contributeur"]
        && request.resource.data.skills is list && request.resource.data.skills.size() <= 20
        && request.resource.data.interests is list && request.resource.data.interests.size() <= 20
        && request.resource.data.availability is string && request.resource.data.availability.size() <= 300
        && request.resource.data.status in ["en_attente", "actif", "inactif", "suspendu", "rejete"]
        && (!("email" in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 160))
        && (!("phone" in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if staffHasScope("volunteers.manage")
        && request.resource.data.keys().hasOnly(["fullName", "email", "phone", "category", "skills", "interests", "availability", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.keys().hasAll(["fullName", "category", "skills", "interests", "availability", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() >= 2 && request.resource.data.fullName.size() <= 120
        && request.resource.data.category in ["occasionnel", "engage", "contributeur"]
        && request.resource.data.skills is list && request.resource.data.skills.size() <= 20
        && request.resource.data.interests is list && request.resource.data.interests.size() <= 20
        && request.resource.data.availability is string && request.resource.data.availability.size() <= 300
        && request.resource.data.status in ["en_attente", "actif", "inactif", "suspendu", "rejete"]
        && (!("email" in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 160))
        && (!("phone" in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // Candidatures au Club : dépôt par le titulaire d'un compte vérifié.
    // L'approbation reste une action explicite d'un gestionnaire autorisé.
    match /volunteerApplications/{applicationId} {
      allow get: if (request.auth != null && request.auth.uid == applicationId
          && request.auth.token.email_verified == true)
        || staffHasScope("volunteers.read") || staffHasScope("volunteers.manage");
      allow list: if staffHasScope("volunteers.read") || staffHasScope("volunteers.manage");
      allow create: if request.auth != null
        && request.auth.uid == applicationId
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(["fullName", "email", "phone", "category", "skills", "interests", "availability", "privacyConsent", "consentAt", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.keys().hasAll(["fullName", "email", "category", "skills", "interests", "availability", "privacyConsent", "consentAt", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() >= 2 && request.resource.data.fullName.size() <= 120
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.category in ["occasionnel", "engage", "contributeur"]
        && validApplicationTextList(request.resource.data.skills)
        && validApplicationTextList(request.resource.data.interests)
        && request.resource.data.availability is string && request.resource.data.availability.size() <= 300
        && request.resource.data.privacyConsent == true
        && request.resource.data.consentAt == request.time
        && request.resource.data.status == "en_attente"
        && (!("phone" in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if staffHasScope("volunteers.manage")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedAt", "reviewedBy", "updatedAt", "updatedBy"])
        && resource.data.status == "en_attente"
        && request.resource.data.status in ["acceptee", "refusee"]
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        // Une acceptation doit créer atomiquement la fiche active correspondante.
        // Un simple changement de statut ne peut plus laisser une candidature acceptée orpheline.
        && (
          request.resource.data.status == "refusee"
          || (
            !exists(/databases/$(database)/documents/volunteers/$(applicationId))
            && existsAfter(/databases/$(database)/documents/volunteers/$(applicationId))
            && getAfter(/databases/$(database)/documents/volunteers/$(applicationId)).data.status == "actif"
            && getAfter(/databases/$(database)/documents/volunteers/$(applicationId)).data.fullName == resource.data.fullName
            && getAfter(/databases/$(database)/documents/volunteers/$(applicationId)).data.email == resource.data.email
            && (
              ("phone" in resource.data && getAfter(/databases/$(database)/documents/volunteers/$(applicationId)).data.phone == resource.data.phone)
              || (!("phone" in resource.data) && getAfter(/databases/$(database)/documents/volunteers/$(applicationId)).data.phone == "")
            )
            && getAfter(/databases/$(database)/documents/volunteers/$(applicationId)).data.category == resource.data.category
            && getAfter(/databases/$(database)/documents/volunteers/$(applicationId)).data.skills == resource.data.skills
            && getAfter(/databases/$(database)/documents/volunteers/$(applicationId)).data.interests == resource.data.interests
            && getAfter(/databases/$(database)/documents/volunteers/$(applicationId)).data.availability == resource.data.availability
            && getAfter(/databases/$(database)/documents/volunteers/$(applicationId)).data.createdBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/volunteers/$(applicationId)).data.updatedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/volunteers/$(applicationId)).data.createdAt == request.time
            && getAfter(/databases/$(database)/documents/volunteers/$(applicationId)).data.updatedAt == request.time
          )
        );
      allow delete: if false;
    }

    function validOptionalUserProfileFields(data) {
      return (!("displayName" in data) || (
          data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        ))
        && (!("country" in data) || (
          data.country is string && data.country.size() >= 2 && data.country.size() <= 80
        ))
        && (!("interest" in data) || data.interest in ["C", "B"])
        && (!("mosque" in data) || (
          data.mosque is string && data.mosque.size() <= 120
        ))
        && (!("learningMode" in data) || data.learningMode in ["seul", "groupe", "presentiel"]);
    }

    match /users/{userId} {
      // Chaque nouvel utilisateur ne peut créer que son propre profil apprenant.
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly([
          "email", "displayName", "role", "country", "interest",
          "mosque", "learningMode", "createdAt"
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "apprenant"
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.country is string
        && request.resource.data.country.size() >= 2
        && request.resource.data.country.size() <= 80
        && request.resource.data.interest in ["C", "B"]
        && request.resource.data.mosque is string
        && request.resource.data.mosque.size() <= 120
        && request.resource.data.learningMode in ["seul", "groupe", "presentiel"]
        && request.resource.data.createdAt == request.time;

      // Un utilisateur ne lit que son profil.
      allow read: if signedInAs(userId);

      // Le rôle et l'adresse e-mail ne peuvent jamais être modifiés par le client.
      allow update: if signedInAs(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["displayName", "country", "interest", "mosque", "learningMode", "updatedAt"])
        && validOptionalUserProfileFields(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;

      // Autorise la suppression du seul profil apprenant par son propriétaire.
      allow delete: if signedInAs(userId) && resource.data.role == "apprenant";
    }

    // Tout le reste reste fermé jusqu'à l'ajout de règles métier vérifiées.
    // Chaque apprenant ne peut lire et synchroniser que ses propres résultats de quiz.
    match /users/{userId}/progress/{lessonId} {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(["lessonId", "score", "total", "updatedAt"])
        && request.resource.data.keys().hasAll(["lessonId", "score", "total", "updatedAt"])
        && request.resource.data.lessonId == lessonId
        && request.resource.data.score is int
        && request.resource.data.total is int
        && request.resource.data.score >= 0
        && request.resource.data.total > 0
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.total <= 20
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Données pédagogiques propres à chaque apprenant : notes privées, pratiques et devoirs écrits.
    match /users/{userId}/learning/{recordId} {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(["kind", "itemId", "value", "date", "updatedAt"])
        && request.resource.data.keys().hasAll(["kind", "itemId", "value", "date", "updatedAt"])
        && request.resource.data.kind in ["reflection", "practice", "submission"]
        && request.resource.data.itemId is string
        && request.resource.data.itemId.size() >= 1
        && request.resource.data.itemId.size() <= 120
        && validIsoDate(request.resource.data.date)
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.kind in ["reflection", "submission"]
            && request.resource.data.value is string
            && request.resource.data.value.size() <= 5000)
          ||
          (request.resource.data.kind == "practice"
            && request.resource.data.value is list
            && request.resource.data.value.size() <= 20)
        );
      allow delete: if false;
    }

    function validFinanceDate(value) {
      return value is string
        && (
          value.matches("^[0-9]{4}-((01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])|(04|06|09|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))$")
          || value.matches("^([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29$")
        );
    }

    match /financeAccounts/{accountId} {
      allow read: if staffHasScope("finance.read") || staffHasScope("finance.control.read")
        || staffHasScope("finance.manage")
        || staffHasScope("finance.validate")
        || staffHasScope("finance.accounts.manage");

      allow create: if staffHasScope("finance.accounts.manage")
        && request.resource.data.keys().hasOnly([
          "name", "type", "institution", "reference", "currency", "status", "openingBalance", "openingDate", "openingFiscalYear", "openingReference",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.keys().hasAll([
          "name", "type", "currency", "status", "openingBalance", "openingDate", "openingFiscalYear", "openingReference",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.type in ["caisse", "banque", "mobile_money"]
        && (!("institution" in request.resource.data) || (request.resource.data.institution is string && request.resource.data.institution.size() <= 120))
        && (!("reference" in request.resource.data) || (request.resource.data.reference is string && request.resource.data.reference.size() <= 4))
        && request.resource.data.currency == "XOF"
        && request.resource.data.openingBalance is int
        && request.resource.data.openingBalance >= 0
        && request.resource.data.openingBalance <= 1000000000000
        && request.resource.data.openingDate is string
        && validFinanceDate(request.resource.data.openingDate)
        && request.resource.data.openingFiscalYear is string
        && request.resource.data.openingFiscalYear.matches("^[0-9]{4}$")
        && request.resource.data.openingDate.matches("^" + request.resource.data.openingFiscalYear + "-[0-9]{2}-[0-9]{2}$")
        && !exists(/databases/$(database)/documents/financePeriods/$(request.resource.data.openingFiscalYear))
        && request.resource.data.openingReference is string
        && request.resource.data.openingReference.size() <= 120
        && request.resource.data.status == "actif"
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      // Un compte ne peut être que clôturé; son identité et ses références restent immuables.
      allow update: if staffHasScope("finance.accounts.manage")
        && (staffHasScope("finance.read") || staffHasScope("finance.manage") || staffHasScope("finance.validate"))
        && resource.data.status == "actif"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "updatedBy"])
        && request.resource.data.status == "clos"
        && request.resource.data.name == resource.data.name
        && request.resource.data.type == resource.data.type
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.openingBalance == resource.data.openingBalance
        && request.resource.data.openingDate == resource.data.openingDate
        && request.resource.data.openingFiscalYear == resource.data.openingFiscalYear
        && request.resource.data.openingReference == resource.data.openingReference
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    match /financeTransactions/{transactionId} {
      allow read: if staffHasScope("finance.read") || staffHasScope("finance.control.read")
        || staffHasScope("finance.manage")
        || staffHasScope("finance.validate");

      // Une opération est créée comme soumise; elle ne touche jamais le solde avant validation.
      allow create: if staffHasScope("finance.manage")
        && request.resource.data.keys().hasOnly([
          "type", "category", "amount", "date", "counterparty", "paymentMethod",
          "reference", "description", "status", "projectId", "projectName", "evidenceRef", "accountId", "accountName", "fiscalYear",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.keys().hasAll([
          "type", "category", "amount", "date", "counterparty", "paymentMethod",
          "reference", "description", "status", "fiscalYear", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.type in ["recette", "depense"]
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 2
        && request.resource.data.category.size() <= 40
        && ((request.resource.data.type == "recette"
          && request.resource.data.category in ["don", "cotisation", "subvention", "collecte", "vente", "autre"])
          || (request.resource.data.type == "depense"
          && request.resource.data.category in ["fonctionnement", "education", "humanitaire", "social", "logistique", "communication", "transport", "equipement", "autre"]))
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000000
        && request.resource.data.date is string
        && validFinanceDate(request.resource.data.date)
        && request.resource.data.fiscalYear is string
        && request.resource.data.fiscalYear.matches("^[0-9]{4}$")
        && request.resource.data.fiscalYear is string
        && request.resource.data.fiscalYear.matches("^[0-9]{4}$")
        && request.resource.data.date.matches("^" + request.resource.data.fiscalYear + "-[0-9]{2}-[0-9]{2}$")
        && !exists(/databases/$(database)/documents/financePeriods/$(request.resource.data.fiscalYear))
        && request.resource.data.counterparty is string
        && request.resource.data.counterparty.size() <= 140
        && request.resource.data.paymentMethod in ["especes", "mobile_money", "virement", "cheque", "nature"]
        && (request.resource.data.type == "recette" || request.resource.data.paymentMethod != "nature")
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 3
        && request.resource.data.description.size() <= 1200
        && request.resource.data.status == "soumise"
        && (
          (("projectId" in request.resource.data) && ("projectName" in request.resource.data)
            && request.resource.data.projectId is string
            && request.resource.data.projectId.size() >= 1
            && request.resource.data.projectId.size() <= 100
            && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
            && request.resource.data.projectName is string
            && request.resource.data.projectName.size() <= 140
            && request.resource.data.projectName == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.name)
          || (!("projectId" in request.resource.data) && !("projectName" in request.resource.data))
        )
        && (!("evidenceRef" in request.resource.data) || (
          request.resource.data.evidenceRef is string
          && request.resource.data.evidenceRef.size() <= 180
        ))
        && (!( "accountId" in request.resource.data) || (
          request.resource.data.accountId is string
          && request.resource.data.accountId.size() >= 1
          && request.resource.data.accountId.size() <= 100
          && request.resource.data.paymentMethod != "nature"
          && exists(/databases/$(database)/documents/financeAccounts/$(request.resource.data.accountId))
          && get(/databases/$(database)/documents/financeAccounts/$(request.resource.data.accountId)).data.status == "actif"
          && get(/databases/$(database)/documents/financeAccounts/$(request.resource.data.accountId)).data.type ==
            (request.resource.data.paymentMethod == "especes" ? "caisse" :
              request.resource.data.paymentMethod == "mobile_money" ? "mobile_money" : "banque")
          && request.resource.data.accountName is string
          && request.resource.data.accountName == get(/databases/$(database)/documents/financeAccounts/$(request.resource.data.accountId)).data.name
          && request.resource.data.date >= get(/databases/$(database)/documents/financeAccounts/$(request.resource.data.accountId)).data.openingDate
        ))
        && (!("accountName" in request.resource.data) || ("accountId" in request.resource.data))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      // Les opérations sont immuables après soumission. Seul un validateur distinct peut les traiter.
      allow update: if staffHasScope("finance.validate")
        && request.auth.uid != resource.data.createdBy
        && resource.data.status == "soumise"
        && request.resource.data.type == resource.data.type
        && request.resource.data.category == resource.data.category
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.date == resource.data.date
        && request.resource.data.fiscalYear == resource.data.fiscalYear
        && request.resource.data.counterparty == resource.data.counterparty
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && request.resource.data.reference == resource.data.reference
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "validatedAt", "validatedBy", "rejectedAt", "rejectedBy",
          "rejectionReason", "updatedAt", "updatedBy"
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          (request.resource.data.status == "validee"
            && (!( "accountId" in resource.data) || (exists(/databases/$(database)/documents/financeAccounts/$(resource.data.accountId)) && get(/databases/$(database)/documents/financeAccounts/$(resource.data.accountId)).data.status == "actif"))
            && !exists(/databases/$(database)/documents/financePeriods/$(resource.data.fiscalYear))
            && request.resource.data.validatedAt == request.time
            && request.resource.data.validatedBy == request.auth.uid
            && !("rejectedAt" in request.resource.data)
            && !("rejectedBy" in request.resource.data)
            && !("rejectionReason" in request.resource.data))
          ||
          (request.resource.data.status == "rejetee"
            && request.resource.data.rejectedAt == request.time
            && request.resource.data.rejectedBy == request.auth.uid
            && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() >= 5
            && request.resource.data.rejectionReason.size() <= 500
            && !("validatedAt" in request.resource.data)
            && !("validatedBy" in request.resource.data))
        );

      allow delete: if false;
    }

    match /financeReconciliations/{reconciliationId} {
      allow read: if staffHasScope("finance.read") || staffHasScope("finance.control.read") || staffHasScope("finance.manage") || staffHasScope("finance.validate");
      allow create: if staffHasScope("finance.manage")
        && request.resource.data.keys().hasOnly([
          "accountId", "accountName", "date", "fiscalYear", "statementBalance",
          "systemBalanceSnapshot", "difference", "reference", "note", "status",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.keys().hasAll([
          "accountId", "accountName", "date", "fiscalYear", "statementBalance",
          "systemBalanceSnapshot", "difference", "reference", "note", "status",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.accountId is string
        && exists(/databases/$(database)/documents/financeAccounts/$(request.resource.data.accountId))
        && get(/databases/$(database)/documents/financeAccounts/$(request.resource.data.accountId)).data.status == "actif"
        && request.resource.data.accountName == get(/databases/$(database)/documents/financeAccounts/$(request.resource.data.accountId)).data.name
        && request.resource.data.date >= get(/databases/$(database)/documents/financeAccounts/$(request.resource.data.accountId)).data.openingDate
        && request.resource.data.date is string
        && request.resource.data.fiscalYear is string
        && request.resource.data.fiscalYear.matches("^[0-9]{4}$")
        && validFinanceDate(request.resource.data.date)
        && request.resource.data.fiscalYear is string
        && request.resource.data.fiscalYear.matches("^[0-9]{4}$")
        && request.resource.data.date.matches("^" + request.resource.data.fiscalYear + "-[0-9]{2}-[0-9]{2}$")
        && !exists(/databases/$(database)/documents/financePeriods/$(request.resource.data.fiscalYear))
        && request.resource.data.statementBalance is int
        && request.resource.data.statementBalance >= 0
        && request.resource.data.statementBalance <= 1000000000000
        && request.resource.data.systemBalanceSnapshot is int
        && request.resource.data.systemBalanceSnapshot >= -1000000000000
        && request.resource.data.systemBalanceSnapshot <= 1000000000000
        && request.resource.data.difference is int
        && request.resource.data.difference >= -1000000000000
        && request.resource.data.difference <= 1000000000000
        && request.resource.data.difference == request.resource.data.statementBalance - request.resource.data.systemBalanceSnapshot
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 120
        && request.resource.data.note is string
        && request.resource.data.note.size() >= 5
        && request.resource.data.note.size() <= 800
        && request.resource.data.status == "soumise"
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if staffHasScope("finance.validate")
        && request.auth.uid != resource.data.createdBy
        && resource.data.status == "soumise"
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.accountName == resource.data.accountName
        && request.resource.data.date == resource.data.date
        && request.resource.data.fiscalYear == resource.data.fiscalYear
        && request.resource.data.statementBalance == resource.data.statementBalance
        && request.resource.data.systemBalanceSnapshot == resource.data.systemBalanceSnapshot
        && request.resource.data.difference == resource.data.difference
        && request.resource.data.reference == resource.data.reference
        && request.resource.data.note == resource.data.note
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "validatedAt", "validatedBy", "rejectedAt", "rejectedBy",
          "rejectionReason", "updatedAt", "updatedBy"
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          (request.resource.data.status == "validee"
            && exists(/databases/$(database)/documents/financeAccounts/$(resource.data.accountId))
            && get(/databases/$(database)/documents/financeAccounts/$(resource.data.accountId)).data.status == "actif"
            && !exists(/databases/$(database)/documents/financePeriods/$(resource.data.fiscalYear))
            && request.resource.data.validatedAt == request.time
            && request.resource.data.validatedBy == request.auth.uid
            && !("rejectedAt" in request.resource.data)
            && !("rejectedBy" in request.resource.data)
            && !("rejectionReason" in request.resource.data))
          ||
          (request.resource.data.status == "rejetee"
            && request.resource.data.rejectedAt == request.time
            && request.resource.data.rejectedBy == request.auth.uid
            && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() >= 5
            && request.resource.data.rejectionReason.size() <= 500
            && !("validatedAt" in request.resource.data)
            && !("validatedBy" in request.resource.data))
        );
      allow delete: if false;
    }

    match /financePeriods/{year} {
      allow read: if staffHasScope("finance.read") || staffHasScope("finance.control.read")
        || staffHasScope("finance.manage")
        || staffHasScope("finance.validate")
        || staffHasScope("finance.periods.manage");

      allow create: if staffHasScope("finance.periods.manage")
        && (staffHasScope("finance.read") || staffHasScope("finance.manage") || staffHasScope("finance.validate"))
        && request.resource.data.keys().hasOnly([
          "year", "status", "note", "snapshot", "closedAt", "closedBy", "createdAt", "createdBy"
        ])
        && request.resource.data.keys().hasAll([
          "year", "status", "closedAt", "closedBy", "createdAt", "createdBy"
        ])
        && request.resource.data.year == year
        && request.resource.data.year.matches("^[0-9]{4}$")
        && int(request.resource.data.year) < request.time.year()
        && request.resource.data.status == "clos"
        && request.resource.data.snapshot is map
        && request.resource.data.snapshot.keys().hasOnly(["receiptsCash", "receiptsInKind", "expenses", "netCash", "validatedTransactionCount", "transferCount", "reconciliationCount", "accountCount", "budgetCount"])
        && request.resource.data.snapshot.keys().hasAll(["receiptsCash", "receiptsInKind", "expenses", "netCash", "validatedTransactionCount", "transferCount", "reconciliationCount", "accountCount", "budgetCount"])
        && request.resource.data.snapshot.receiptsCash is int
        && request.resource.data.snapshot.receiptsCash >= 0
        && request.resource.data.snapshot.receiptsCash <= 1000000000000
        && request.resource.data.snapshot.receiptsInKind is int
        && request.resource.data.snapshot.receiptsInKind >= 0
        && request.resource.data.snapshot.receiptsInKind <= 1000000000000
        && request.resource.data.snapshot.expenses is int
        && request.resource.data.snapshot.expenses >= 0
        && request.resource.data.snapshot.expenses <= 1000000000000
        && request.resource.data.snapshot.netCash is int
        && request.resource.data.snapshot.netCash == request.resource.data.snapshot.receiptsCash - request.resource.data.snapshot.expenses
        && request.resource.data.snapshot.validatedTransactionCount is int
        && request.resource.data.snapshot.validatedTransactionCount >= 0
        && request.resource.data.snapshot.validatedTransactionCount <= 1000000
        && request.resource.data.snapshot.transferCount is int
        && request.resource.data.snapshot.transferCount >= 0
        && request.resource.data.snapshot.transferCount <= 1000000
        && request.resource.data.snapshot.reconciliationCount is int
        && request.resource.data.snapshot.reconciliationCount >= 0
        && request.resource.data.snapshot.reconciliationCount <= 1000000
        && request.resource.data.snapshot.accountCount is int
        && request.resource.data.snapshot.accountCount >= 0
        && request.resource.data.snapshot.accountCount <= 1000000
        && request.resource.data.snapshot.budgetCount is int
        && request.resource.data.snapshot.budgetCount >= 0
        && request.resource.data.snapshot.budgetCount <= 1000000
        && (!("note" in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && request.resource.data.closedAt == request.time
        && request.resource.data.closedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }

    match /financeTransfers/{transferId} {
      allow read: if staffHasScope("finance.read") || staffHasScope("finance.control.read")
        || staffHasScope("finance.manage")
        || staffHasScope("finance.validate");

      allow create: if staffHasScope("finance.manage")
        && request.resource.data.keys().hasOnly([
          "sourceAccountId", "sourceName", "destinationAccountId", "destinationName",
          "amount", "date", "reference", "description", "status", "fiscalYear",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.keys().hasAll([
          "sourceAccountId", "sourceName", "destinationAccountId", "destinationName",
"amount", "date", "reference", "description", "status", "fiscalYear",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.sourceAccountId is string
        && request.resource.data.sourceAccountId.size() >= 1
        && request.resource.data.sourceAccountId.size() <= 100
        && request.resource.data.destinationAccountId is string
        && request.resource.data.destinationAccountId.size() >= 1
        && request.resource.data.destinationAccountId.size() <= 100
        && request.resource.data.sourceAccountId != request.resource.data.destinationAccountId
        && exists(/databases/$(database)/documents/financeAccounts/$(request.resource.data.sourceAccountId))
        && exists(/databases/$(database)/documents/financeAccounts/$(request.resource.data.destinationAccountId))
        && get(/databases/$(database)/documents/financeAccounts/$(request.resource.data.sourceAccountId)).data.status == "actif"
        && get(/databases/$(database)/documents/financeAccounts/$(request.resource.data.destinationAccountId)).data.status == "actif"
        && request.resource.data.sourceName == get(/databases/$(database)/documents/financeAccounts/$(request.resource.data.sourceAccountId)).data.name
        && request.resource.data.date >= get(/databases/$(database)/documents/financeAccounts/$(request.resource.data.sourceAccountId)).data.openingDate
        && request.resource.data.destinationName == get(/databases/$(database)/documents/financeAccounts/$(request.resource.data.destinationAccountId)).data.name
        && request.resource.data.date >= get(/databases/$(database)/documents/financeAccounts/$(request.resource.data.destinationAccountId)).data.openingDate
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000000
        && request.resource.data.date is string
        && validFinanceDate(request.resource.data.date)
        && request.resource.data.fiscalYear is string
        && request.resource.data.fiscalYear.matches("^[0-9]{4}$")
        && request.resource.data.date.matches("^" + request.resource.data.fiscalYear + "-[0-9]{2}-[0-9]{2}$")
        && !exists(/databases/$(database)/documents/financePeriods/$(request.resource.data.fiscalYear))
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 3
        && request.resource.data.description.size() <= 500
        && request.resource.data.status == "soumise"
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if staffHasScope("finance.validate")
        && request.auth.uid != resource.data.createdBy
        && resource.data.status == "soumise"
        && request.resource.data.sourceAccountId == resource.data.sourceAccountId
        && request.resource.data.sourceName == resource.data.sourceName
        && request.resource.data.destinationAccountId == resource.data.destinationAccountId
        && request.resource.data.destinationName == resource.data.destinationName
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.date == resource.data.date
        && request.resource.data.fiscalYear == resource.data.fiscalYear
        && request.resource.data.reference == resource.data.reference
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "validatedAt", "validatedBy", "rejectedAt", "rejectedBy",
          "rejectionReason", "updatedAt", "updatedBy"
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          (request.resource.data.status == "validee"
            && !exists(/databases/$(database)/documents/financePeriods/$(resource.data.fiscalYear))
            && exists(/databases/$(database)/documents/financeAccounts/$(resource.data.sourceAccountId))
            && exists(/databases/$(database)/documents/financeAccounts/$(resource.data.destinationAccountId))
            && get(/databases/$(database)/documents/financeAccounts/$(resource.data.sourceAccountId)).data.status == "actif"
            && get(/databases/$(database)/documents/financeAccounts/$(resource.data.destinationAccountId)).data.status == "actif"
            && request.resource.data.validatedAt == request.time
            && request.resource.data.validatedBy == request.auth.uid
            && !("rejectedAt" in request.resource.data)
            && !("rejectedBy" in request.resource.data)
            && !("rejectionReason" in request.resource.data))
          ||
          (request.resource.data.status == "rejetee"
            && request.resource.data.rejectedAt == request.time
            && request.resource.data.rejectedBy == request.auth.uid
            && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() >= 5
            && request.resource.data.rejectionReason.size() <= 500
            && !("validatedAt" in request.resource.data)
            && !("validatedBy" in request.resource.data))
        );

      allow delete: if false;
    }

    match /financeBudgets/{budgetId} {
      allow read: if staffHasScope("finance.read") || staffHasScope("finance.control.read")
        || staffHasScope("finance.manage")
        || staffHasScope("finance.validate")
        || staffHasScope("finance.budgets.manage");

      allow create: if staffHasScope("finance.budgets.manage")
        && request.resource.data.keys().hasOnly([
          "name", "year", "amount", "category", "status", "note",
          "projectId", "projectName", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.keys().hasAll([
          "name", "year", "amount", "category", "status",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.year is int
        && request.resource.data.year >= 2020
        && request.resource.data.year <= 2100
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000000
        && request.resource.data.category in ["fonctionnement", "education", "humanitaire", "social", "projet", "autre"]
        && request.resource.data.status == "actif"
        && !exists(/databases/$(database)/documents/financePeriods/$(request.resource.data.year))
        && (!("note" in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && (
          (("projectId" in request.resource.data) && ("projectName" in request.resource.data)
            && request.resource.data.projectId is string
            && request.resource.data.projectId.size() >= 1
            && request.resource.data.projectId.size() <= 100
            && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
            && request.resource.data.projectName is string
            && request.resource.data.projectName.size() <= 140
            && request.resource.data.projectName == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.name)
          || (!("projectId" in request.resource.data) && !("projectName" in request.resource.data))
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if staffHasScope("finance.budgets.manage")
        && resource.data.status == "actif"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "updatedBy"])
        && request.resource.data.status == "clos"
        && request.resource.data.keys().hasOnly([
          "name", "year", "amount", "category", "status", "note",
          "projectId", "projectName", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.keys().hasAll([
          "name", "year", "amount", "category", "status",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.year is int
        && request.resource.data.year >= 2020
        && request.resource.data.year <= 2100
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000000
        && request.resource.data.category in ["fonctionnement", "education", "humanitaire", "social", "projet", "autre"]
        && request.resource.data.status in ["actif", "clos"]
        && (!("note" in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && (
          (("projectId" in request.resource.data) && ("projectName" in request.resource.data)
            && request.resource.data.projectId is string
            && request.resource.data.projectId.size() >= 1
            && request.resource.data.projectId.size() <= 100
            && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
            && request.resource.data.projectName is string
            && request.resource.data.projectName.size() <= 140
            && request.resource.data.projectName == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.name)
          || (!("projectId" in request.resource.data) && !("projectName" in request.resource.data))
        )
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    match /financeControlObservations/{observationId} {
      allow read: if staffHasScope("finance.control.read");
      allow create: if staffHasScope("finance.control.observe")
        && request.resource.data.keys().hasOnly([
          "title", "description", "severity", "status", "referenceType", "referenceId",
          "projectId", "funderId", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.keys().hasAll([
          "title", "description", "severity", "status", "referenceType", "referenceId",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 4000
        && request.resource.data.severity in ["faible", "moderee", "elevee", "critique"]
        && request.resource.data.status == "ouverte"
        && request.resource.data.referenceType in ["operation", "ecriture", "budget", "banque", "bailleur", "convention", "piece", "cloture", "autre"]
        && request.resource.data.referenceId is string
        && request.resource.data.referenceId.size() >= 1
        && request.resource.data.referenceId.size() <= 160
        && (!("projectId" in request.resource.data) || (request.resource.data.projectId is string && request.resource.data.projectId.size() <= 120))
        && (!("funderId" in request.resource.data) || (request.resource.data.funderId is string && request.resource.data.funderId.size() <= 120))
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if staffHasScope("finance.control.observe")
        && resource.data.createdBy == request.auth.uid
        && resource.data.status == "ouverte"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["description", "updatedAt", "updatedBy"])
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 4000
        && request.resource.data.title == resource.data.title
        && request.resource.data.severity == resource.data.severity
        && request.resource.data.referenceType == resource.data.referenceType
        && request.resource.data.referenceId == resource.data.referenceId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /financeControlReports/{reportId} {
      allow read: if staffHasScope("finance.control.read");
      allow create: if staffHasScope("finance.control.observe")
        && request.resource.data.keys().hasOnly([
          "title", "periodStart", "periodEnd", "summary", "findingCount",
          "projectId", "funderId", "createdAt", "createdBy"
        ])
        && request.resource.data.keys().hasAll([
          "title", "periodStart", "periodEnd", "summary", "findingCount",
          "createdAt", "createdBy"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 160
        && validFinanceDate(request.resource.data.periodStart)
        && validFinanceDate(request.resource.data.periodEnd)
        && request.resource.data.periodEnd >= request.resource.data.periodStart
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 20
        && request.resource.data.summary.size() <= 8000
        && request.resource.data.findingCount is int
        && request.resource.data.findingCount >= 0
        && request.resource.data.findingCount <= 10000
        && (!("projectId" in request.resource.data) || (request.resource.data.projectId is string && request.resource.data.projectId.size() <= 120))
        && (!("funderId" in request.resource.data) || (request.resource.data.funderId is string && request.resource.data.funderId.size() <= 120))
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}